{
  "App": {
    "SelfUrl": "https://localhost:44328",
    "AngularUrl": "http://localhost:4200",
    "CorsOrigins": "https://*.SmartPantry.com,http://localhost:4200,",
    "RedirectAllowedUrls": "http://localhost:4200,",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Server=.\\SQLEXPRESS; Database=SmartPantry; Trusted_Connection=True; TrustServerCertificate=True"
  },
  "AuthServer": {
    "Authority": "https://localhost:44328",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "SmartPantry_Swagger",
    "CertificatePassPhrase": "7976129c-62f3-4a60-b929-880b3fd71e7c"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "QOdLO6y8FSPYn1ZA"
  }
}